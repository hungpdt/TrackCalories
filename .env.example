# Sao chép thành .env.local (Git bỏ qua). Supabase local: lấy giá trị từ `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key, dùng cùng RLS. Không đặt SECRET_KEY/SERVICE_ROLE_KEY ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (G6–G7); never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
