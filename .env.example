# Sao chép thành .env.local (Git bỏ qua). Supabase local: lấy giá trị từ `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key, dùng cùng RLS. Không đặt SECRET_KEY/SERVICE_ROLE_KEY ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AI "Ghi nhanh" — chỉ phía server, không bao giờ thêm tiền tố NEXT_PUBLIC_.
# Key lấy từ platform.openai.com (gói ChatGPT Plus không gồm quyền gọi API).
OPENAI_API_KEY=
# Model hỗ trợ ảnh + structured output, ví dụ tên model hiện hành trong tài liệu OpenAI.
OPENAI_MODEL=
# Số lượt AI tối đa mỗi tài khoản mỗi ngày (mặc định 30).
AI_DAILY_LIMIT=30
# Đặt "mock" để dùng AI giả lập (test/CI, không gọi mạng). Để trống khi dùng OpenAI thật.
AI_PROVIDER=
# Thử trên điện thoại cùng mạng (npm run dev:lan): IP máy tính, nhiều giá trị cách nhau bằng dấu phẩy.
DEV_ORIGINS=
# Mức suy luận cho model gpt-5*/o* (none|minimal|low|medium|high). Mặc định low: nhanh hơn ~3 lần, đủ cho ước tính.
OPENAI_REASONING_EFFORT=
